# ImmuTrack Environment Configuration
DEBUG=True
SECRET_KEY=django-insecure-immutrack-dev-secret-key-change-in-production-2026
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (Defaults to local SQLite)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=immutrack_db
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# Email Delivery Configuration (Default console backend prints to terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply.immutrack@example.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=ImmuTrack Healthcare <noreply.immutrack@example.com>
